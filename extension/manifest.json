{
  "manifest_version": 3,
  "name": "Study Shield",
  "version": "0.3.2",
  "description": "Applies school website policies and checks YouTube videos for educational purpose.",
  "permissions": ["storage", "tabs", "idle", "alarms", "system.memory"],
  "host_permissions": ["<all_urls>"],
  "storage": { "managed_schema": "policy-schema.json" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "exclude_matches": ["*://*.youtube.com/*"],
      "js": ["web-content.js"],
      "css": ["web-content.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/loading.webp"],
      "matches": ["*://*.youtube.com/*"]
    },
    {
      "resources": ["assets/blocked-shield.webp"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "options_page": "options.html"
}
