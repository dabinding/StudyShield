{
  "manifest_version": 3,
  "name": "Study Shield",
  "version": "0.2.0",
  "description": "Checks YouTube videos for educational purpose and blocks denied playback.",
  "permissions": ["storage", "tabs", "idle", "alarms", "system.memory"],
  "host_permissions": ["<all_urls>"],
  "storage": { "managed_schema": "policy-schema.json" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["assets/loading.webp", "assets/blocked-shield.webp"],
      "matches": ["*://*.youtube.com/*"]
    }
  ],
  "options_page": "options.html"
}
